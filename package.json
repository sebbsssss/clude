{
  "name": "@clude/sdk",
  "version": "3.3.0",
  "mcpName": "io.github.sebbsssss/clude",
  "description": "Persistent memory SDK for AI agents — Stanford Generative Agents architecture on Supabase + pgvector",
  "main": "dist/sdk/index.js",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "require": "./dist/sdk/index.js"
    },
    "./schema": "./supabase-schema.sql",
    "./local": {
      "types": "./dist/mcp/local-store.d.ts",
      "require": "./dist/mcp/local-store.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "require": "./dist/mcp/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "clude": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "supabase-schema.sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:publish": "node scripts/build-publish.mjs",
    "prepublishOnly": "pnpm --filter @clude/brain... build && node scripts/build-publish.mjs",
    "typecheck": "tsc --noEmit",
    "dashboard": "cd apps/dashboard && pnpm run dev",
    "dashboard:build": "cd apps/dashboard && pnpm run build"
  },
  "keywords": [
    "ai-agent",
    "memory",
    "cognitive-architecture",
    "generative-agents",
    "solana",
    "supabase",
    "pgvector",
    "anthropic",
    "claude",
    "embeddings",
    "dream-cycle",
    "sdk",
    "persistent-memory",
    "agent-memory",
    "llm",
    "mcp",
    "long-term-memory",
    "memory-system",
    "vector-search",
    "knowledge-graph",
    "rag",
    "langchain",
    "ai-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebbsssss/clude.git"
  },
  "homepage": "https://clude.io",
  "bugs": {
    "url": "https://github.com/sebbsssss/clude/issues"
  },
  "author": "sebbsssss",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@huggingface/transformers": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.95.3",
    "better-sqlite3": "^12.9.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.0",
    "murmurhash3js": "^3.0.1",
    "node-cron": "^3.0.3",
    "pino": "^9.0.0",
    "sqlite-vec": "^0.1.9",
    "tweetnacl": "^1.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.11",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "utf-8-validate": "^5.0.10"
  },
  "types": "./dist/sdk/index.d.ts"
}
